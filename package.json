{
  "name": "estoque-moveis",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema interno de estoque e vitrine para loja de móveis",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/db",
    "test:e2e": "playwright test",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "verificar:worker": "node scripts/verificar-tamanho-worker.mjs",
    "deploy:cloudflare": "opennextjs-cloudflare build && node scripts/verificar-tamanho-worker.mjs && opennextjs-cloudflare deploy",
    "deploy:vercel": "npx vercel@latest deploy --prod",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "postinstall": "node scripts/copiar-vendor.mjs",
    "gerar:modelo": "node scripts/gerar-modelo-xlsx.mjs",
    "gerar:fotos": "node scripts/gerar-fotos-ficticias.mjs",
    "enviar:fotos": "node --env-file=.env.local scripts/enviar-fotos-seed.mjs",
    "juntar:migracoes": "node scripts/juntar-migracoes.mjs",
    "preparar:logo": "node scripts/preparar-logo.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@zxing/browser": "^0.2.1",
    "aws4fetch": "^1.0.20",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.12.1",
    "framer-motion": "^14.14.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.80.0",
    "next": "^16.4.6",
    "pdfjs-dist": "^6.5.438",
    "radix-ui": "latest",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@opennextjs/cloudflare": "^1.20.19",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "pg": "^8.16.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  }
}
