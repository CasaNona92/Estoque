# Copie para .env.local (desenvolvimento) e preencha. NUNCA versione o .env.local.
# Nenhuma destas chaves tem prefixo NEXT_PUBLIC_: elas ficam só no servidor.

# Supabase → Project Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# chave "anon"/"publishable" (o navegador nunca recebe; usada só pelo servidor com a sessão do usuário)
SUPABASE_ANON_KEY=
# chave "service_role"/"secret" — PODER TOTAL, só no servidor
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (bucket privado das fotos e notas) → R2 → Manage API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=estoque-fotos

# Público (aparece na tela)
NEXT_PUBLIC_NOME_LOJA=Casa da Nona

# Código secreto (12+ caracteres) para a tela /primeiro-acesso criar o administrador principal.
# Só funciona enquanto não existe nenhum usuário. Pode apagar depois da instalação.
CODIGO_INSTALACAO=
# Domínio dos e-mails internos de funcionários sem e-mail (eles entram pelo usuário)
DOMINIO_EMAIL_INTERNO=casadanona.local

# Só para testes E2E (Playwright) — usuário de teste criado no seu Supabase de testes
E2E_USUARIO=
E2E_SENHA=
